{
  "manifest_version": 3,
  "name": "Telegram Screenshot Services",
  "version": "3.0.0",
  "description": "Multi-service webpage screenshot automation with Telegram.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.telegram.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Telegram Screenshot Services"
  },
  "background": {
    "service_worker": "background.js"
  }
}